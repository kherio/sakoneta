# Los valores por defecto de PHP (upload_max_filesize=2M en muchas
# instalaciones de Debian) son demasiado bajos para fotos de móvil
# normales. Esto los eleva para este sitio sin tocar la configuración
# global del servidor.
#
# Solo funciona si PHP corre como módulo de Apache (mod_php). Si tu
# servidor usa PHP-FPM (lo más habitual con Apache event/worker o con
# Nginx), estos php_value se ignoran: usa el fichero .user.ini de al
# lado en su lugar (y puede que tengas que reiniciar/recargar PHP-FPM).

<IfModule mod_php.c>
    php_value upload_max_filesize 90M
    php_value post_max_size 200M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 90M
    php_value post_max_size 200M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 90M
    php_value post_max_size 200M
</IfModule>
<IfModule mod_php.c>
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# Bloquear el acceso directo desde el navegador a la carpeta .git y a
# cualquier archivo oculto (dotfile). Sin esto, alguien podría
# descargarse todo el código y el historial del repositorio con solo
# conocer la URL, incluidas versiones antiguas de archivos.
<IfModule mod_authz_core.c>
    <DirectoryMatch "(^|/)\.git">
        Require all denied
    </DirectoryMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <DirectoryMatch "(^|/)\.git">
        Order allow,deny
        Deny from all
    </DirectoryMatch>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
