# No permitir que el navegador liste el contenido de ninguna carpeta
# del proyecto que no tenga un index.php/html propio (admin/css/,
# includes/, js/, img/, data/...). Se aplica a esta carpeta y a todas
# las de dentro, salvo que alguna tenga su propio .htaccess que diga
# lo contrario (ninguna lo hace en este proyecto).
Options -Indexes

# Redundante con el "Options -Indexes" de arriba y con el index.php
# que hay dentro de cada carpeta sin nada público que mostrar (ver
# css/, js/, includes/, img/, data/...), pero por si "Options" no
# estuviera permitido en este servidor (según cómo tenga configurado
# AllowOverride), esto asegura que si hay un index.php, se sirva ese
# en vez de intentar listar la carpeta.
DirectoryIndex index.php index.html

# Los valores por defecto de PHP (upload_max_filesize=2M en muchas
# instalaciones de Debian) son demasiado bajos para fotos de móvil
# normales. Esto los eleva para este sitio sin tocar la configuración
# global del servidor.
#
# Solo funciona si PHP corre como módulo de Apache (mod_php). Si tu
# servidor usa PHP-FPM (lo más habitual con Apache event/worker o con
# Nginx), estos php_value se ignoran: usa el fichero .user.ini de al
# lado en su lugar (y puede que tengas que reiniciar/recargar PHP-FPM).

<IfModule mod_php.c>
    php_value upload_max_filesize 90M
    php_value post_max_size 200M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 90M
    php_value post_max_size 200M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 90M
    php_value post_max_size 200M
</IfModule>
<IfModule mod_php.c>
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# Redirección HTTP → HTTPS a nivel de servidor. Es un refuerzo:
# config.php ya hace esta misma redirección a nivel de aplicación (y
# de hecho es la que manda si el servidor comparte IP con otros
# sitios que sí necesiten HTTP), pero tenerla aquí también protege
# cualquier petición que por lo que sea no llegara a ejecutar PHP.
# Comentado por defecto: solo tiene sentido activarlo si este sitio
# tiene su propio certificado SSL en el servidor real y quieres que
# el propio Apache corte el paso antes de llegar a PHP. Descomenta
# las 3 líneas si es tu caso.
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTPS} off
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Bloquear cualquier URL que pase por una carpeta .git (ej. /.git/config,
# /.git/HEAD, /.git/objects/...). RewriteRule sí es válido en .htaccess
# (a diferencia de <DirectoryMatch>, que NO lo es y podía provocar un
# error 500 aquí). La mayoría de archivos dentro de .git/ no empiezan
# por punto (config, HEAD, objects/...), así que hace falta esto y no
# solo bloquear "archivos ocultos".
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.git(/|$)" - [F,L]
</IfModule>

# Bloquear también el acceso directo a cualquier otro archivo oculto
# (dotfile) como refuerzo adicional.
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# IMPORTANTE: esto es un cierre de emergencia, no la solución de
# verdad. Lo correcto es que la carpeta .git NUNCA llegue al servidor
# de producción — despliega copiando solo los archivos del proyecto,
# o con "git archive", no clonando el repositorio directamente dentro
# del docroot público si puedes evitarlo.
